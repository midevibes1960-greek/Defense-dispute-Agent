# PayPal — sandbox keys from https://developer.paypal.com/dashboard (Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: enables webhook signature verification (Webhooks section of your PayPal app)
PAYPAL_WEBHOOK_ID=
# Optional AI decision layer — any OpenAI-compatible endpoint. Without it the
# explainable rules engine runs and is labelled "rules-v1" in the UI.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Local database location (defaults to ./data/db.json)
DATA_DIR=
